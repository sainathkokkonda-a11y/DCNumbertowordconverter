<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Number to Words Converter</title>
  
  <style>
    :root {
      --primary-blue: #1565c0;
      --header-blue: #1155ab;
      --light-bg: #e8f4fe;
      --border-blue: #90caf9;
      --text-color: #0d47a1;
      --dark-text: #1a237e;
    }

    * {
      box-sizing: border-box;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }

    body {
      background-color: #f4f7fa;
      margin: 0;
      padding: 12px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }

    .tool-card {
      width: 100%;
      max-width: 600px;
      background: #ffffff;
      border: 2px solid var(--primary-blue);
      border-radius: 16px;
      box-shadow: 0 8px 25px rgba(21, 101, 192, 0.12);
      overflow: hidden;
    }

    .header-box {
      background: var(--header-blue);
      color: #ffffff;
      padding: 20px 16px;
      text-align: center;
    }

    .header-box h2 {
      margin: 0;
      font-size: 22px;
      font-weight: 700;
      letter-spacing: -0.3px;
    }

    .header-box p {
      margin: 5px 0 0 0;
      font-size: 13px;
      opacity: 0.9;
    }

    .form-body {
      padding: 20px 16px;
    }

    .input-group {
      margin-bottom: 14px;
    }

    .input-group label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-color);
      margin-bottom: 6px;
    }

    .custom-input, .custom-select {
      width: 100%;
      padding: 12px;
      font-size: 15px;
      color: var(--dark-text);
      background-color: #ffffff;
      border: 1.5px solid var(--border-blue);
      border-radius: 8px;
      outline: none;
      transition: all 0.2s ease;
    }

    .custom-input:focus, .custom-select:focus {
      border-color: var(--primary-blue);
      box-shadow: 0 0 0 3px rgba(21, 101, 192, 0.15);
    }

    .section-card {
      background: var(--light-bg);
      border: 1.5px solid var(--border-blue);
      border-radius: 12px;
      padding: 16px;
      margin-top: 16px;
    }

    .result-title {
      font-size: 13px;
      font-weight: 700;
      color: var(--text-color);
      margin-bottom: 8px;
    }

    .result-text {
      font-size: 16px;
      font-weight: 700;
      color: var(--dark-text);
      word-wrap: break-word;
      line-height: 1.4;
    }

    .btn-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
      gap: 10px;
      margin-top: 14px;
    }

    .btn {
      padding: 12px 8px;
      border: none;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      text-align: center;
      transition: background 0.2s ease, transform 0.1s ease;
    }

    .btn:active {
      transform: scale(0.98);
    }

    .btn-primary { background: var(--primary-blue); color: #ffffff; }
    .btn-primary:hover { background: var(--header-blue); }

    .btn-secondary { background: #455a64; color: #ffffff; }
    .btn-secondary:hover { background: #37474f; }

    .btn-danger { background: #e53935; color: #ffffff; }
    .btn-danger:hover { background: #c62828; }

    @media (max-width: 580px) {
      body { padding: 0px; }
      .header-box h2 { font-size: 20px; }
      .btn-grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
</head>
<body>

<div class="tool-card">
  <div class="header-box">
    <h2>Number to Words Converter</h2>
    <p>Convert numbers into words instantly (Indian & International)</p>
  </div>

  <div class="form-body">
    
    <!-- Input Number -->
    <div class="input-group">
      <label for="numberInput">Enter Number:</label>
      <input type="number" id="numberInput" class="custom-input" placeholder="e.g. 12500" oninput="convertNumber()">
    </div>

    <!-- Format Selection -->
    <div class="input-group">
      <label for="formatSelect">Number Format System:</label>
      <select id="formatSelect" class="custom-select" onchange="convertNumber()">
        <option value="indian">Indian System (Lakhs, Crores)</option>
        <option value="international">International System (Millions, Billions)</option>
      </select>
    </div>

    <!-- Output Result -->
    <div class="section-card">
      <div class="result-title">Words Output:</div>
      <div id="resultOutput" class="result-text">Enter a number above to see the output...</div>
    </div>

    <!-- Buttons -->
    <div class="btn-grid">
      <button class="btn btn-primary" onclick="copyResult()">Copy Words</button>
      <button class="btn btn-danger" onclick="clearAll()">Clear</button>
    </div>

  </div>
</div>

<script>
  const a = ['', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'];
  const b = ['', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety'];

  function inWordsIndian(num) {
    if ((num = num.toString()).length > 9) return 'Number too large';
    let n = ('000000000' + num).substr(-9);
    let match = n.match(/^(\d{2})(\d{2})(\d{2})(\d{1})(\d{2})$/);
    if (!match) return '';
    let str = '';
    str += (Number(match[1]) !== 0) ? (a[Number(match[1])] || b[match[1][0]] + ' ' + a[match[1][1]]) + ' Crore ' : '';
    str += (Number(match[2]) !== 0) ? (a[Number(match[2])] || b[match[2][0]] + ' ' + a[match[2][1]]) + ' Lakh ' : '';
    str += (Number(match[3]) !== 0) ? (a[Number(match[3])] || b[match[3][0]] + ' ' + a[match[3][1]]) + ' Thousand ' : '';
    str += (Number(match[4]) !== 0) ? (a[Number(match[4])] || b[match[4][0]] + ' ' + a[match[4][1]]) + ' Hundred ' : '';
    str += (Number(match[5]) !== 0) ? ((str !== '') ? 'and ' : '') + (a[Number(match[5])] || b[match[5][0]] + ' ' + a[match[5][1]]) : '';
    return str.trim();
  }

  function inWordsInternational(num) {
    if (num === 0) return 'Zero';
    const units = ['', 'Thousand', 'Million', 'Billion'];
    let str = '';
    let unitIdx = 0;

    while (num > 0) {
      let chunk = num % 1000;
      if (chunk > 0) {
        let chunkStr = '';
        let h = Math.floor(chunk / 100);
        let r = chunk % 100;

        if (h > 0) chunkStr += a[h] + ' Hundred ';
        if (r > 0) {
          if (r < 20) chunkStr += a[r] + ' ';
          else chunkStr += b[Math.floor(r / 10)] + ' ' + a[r % 10] + ' ';
        }
        str = chunkStr.trim() + ' ' + units[unitIdx] + ' ' + str;
      }
      num = Math.floor(num / 1000);
      unitIdx++;
    }
    return str.trim();
  }

  function convertNumber() {
    const numVal = document.getElementById('numberInput').value.trim();
    const format = document.getElementById('formatSelect').value;
    const output = document.getElementById('resultOutput');

    if (!numVal) {
      output.innerText = "Enter a number above to see the output...";
      return;
    }

    const num = parseInt(numVal, 10);
    if (isNaN(num) || num < 0) {
      output.innerText = "Please enter a valid positive number.";
      return;
    }

    if (num === 0) {
      output.innerText = "Zero Only";
      return;
    }

    let result = '';
    if (format === 'indian') {
      result = inWordsIndian(num);
    } else {
      result = inWordsInternational(num);
    }

    output.innerText = result ? result + " Only" : "Number too large";
  }

  function clearAll() {
    document.getElementById('numberInput').value = '';
    document.getElementById('resultOutput').innerText = "Enter a number above to see the output...";
  }

  function copyResult() {
    const text = document.getElementById('resultOutput').innerText;
    if (text.includes("Enter a number") || text.includes("valid")) return;
    navigator.clipboard.writeText(text).then(() => {
      alert("Words copied to clipboard!");
    });
  }
</script>

</body>
</html>
